FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-strong-password
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:6002,http://localhost:5173,http://localhost:3000


POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoices_ocr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_MIN_SIZE=0
POSTGRES_POOL_MAX_SIZE=5
CLIENT_MATCH_THRESHOLD=92

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
BULK_UPLOAD_MAX_FILES=20

UPLOAD_FOLDER=uploads/original
EXPORT_FOLDER=exports
MAX_UPLOAD_MB=50

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_FILE_DETAIL=high
